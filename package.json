    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "65.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.9.9",
    "typescript": "6.0",
    "typescript-eslint": "8.71.1"
